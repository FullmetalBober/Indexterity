{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "API_PORT",
    "WEB_PORT",
    "DATABASE_URL",
    "MONGO_URL",
    "MASTER_KEY",
    "MASTER_KEY_V*",
    "MASTER_KEY_VERSION",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "WEB_ORIGIN",
    "API_URL",
    "SITE_URL",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "SMTP_*",
    "MAIL_FROM",
    "LOG_LEVEL",
    "SIGNUP_MODE",
    "REQUIRE_EMAIL_VERIFICATION",
    "ALLOW_PRIVATE_CLUSTER_TARGETS",
    "STORAGE_USD_PER_GB_MONTH",
    "WORKER_CONCURRENCY",
    "RUN_CRONJOB",
    "CRON_TRIGGER_SECRET",
    "METRICS_ENABLED",
    "METRICS_PORT",
    "SENTRY_DSN",
    "SENTRY_DSN_API",
    "SENTRY_DSN_WEB",
    "SENTRY_ENVIRONMENT",
    "INT_API_PORT",
    "WEB_METRICS_PORT",
    "WEB_SENTRY_DSN",
    "SUPERVISOR_GRACE_MS",
    "NODE_OPTIONS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".nitro/**", "src/routeTree.gen.ts"]
    },
    // No `^build`, and no wait. Every internal package now declares
    // `exports["."].types` as `./src/index.ts`, so a consumer type-checks
    // against the source it was going to be built from rather than against a
    // `.d.ts` that has to exist first — which means the five typechecks all
    // start at once instead of queueing behind three builds.
    //
    // `transit` is what keeps the caching honest without the wait: it matches no
    // package script, so it completes instantly, and depending on it is what
    // tells turbo that a change in @repo/contracts must re-run the api's
    // typecheck. Without it this task would be the mistake #142 fixed for
    // `test` — cached against nothing.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    // scripts/ belongs to no workspace, so the fan-out above never reaches it.
    // A root task is how turbo runs something in the repo root itself, and
    // `npm run typecheck` asks for both — otherwise the only source files CI
    // never type-checks would stay that way.
    "//#typecheck:scripts": {
      "inputs": ["scripts/**/*.ts", "tsconfig.scripts.json", "packages/config/tsconfig.base.json"]
    },
    // `^build`, not nothing. Both suites import @repo/contracts, whose package
    // main is dist/index.js — so without a dependency here `npm test` on a fresh
    // clone cannot resolve it, and, worse, turbo has no reason to re-run a suite
    // when the contract it asserts against changes: append a line to
    // packages/contracts/src/index.ts and @repo/api:test is still FULL TURBO.
    // The suite that would have caught the change is the one that exists to
    // catch it — contract-routes.test.ts is the CSRF "no state-changing GET"
    // check, reading the contract by reflection. CI restores `.turbo` by prefix
    // (turbo-, ci.yml), so the stale hit is reachable there too, not just
    // locally. A transit node would give the awareness without the wait, but
    // these tests genuinely need the built output, not just knowledge of it.
    "test": {
      "dependsOn": ["^build"]
    },
    // No `lint` task: nothing to register one for. Linting is one biome pass
    // over the whole repo plus the tailwind check (root package.json), because
    // biome reads every workspace from one config and splitting it per package
    // would be slower than the ~1s it takes. Declared as a turbo task it matched
    // no package script, so `turbo run lint` answered "No tasks were executed"
    // — config that promised caching and delivered nothing.
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
