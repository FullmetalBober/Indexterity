{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "API_PORT",
    "WEB_PORT",
    "DATABASE_URL",
    "MONGO_URL",
    "MASTER_KEY",
    "MASTER_KEY_V*",
    "MASTER_KEY_VERSION",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "WEB_ORIGIN",
    "API_URL",
    "SITE_URL",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "SMTP_*",
    "MAIL_FROM",
    "LOG_LEVEL",
    "SIGNUP_MODE",
    "REQUIRE_EMAIL_VERIFICATION",
    "ALLOW_PRIVATE_CLUSTER_TARGETS",
    "STORAGE_USD_PER_GB_MONTH",
    "WORKER_CONCURRENCY",
    "INT_API_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".nitro/**", "src/routeTree.gen.ts"],
      "env": ["VITE_API_URL", "VITE_WEB_ORIGIN"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
