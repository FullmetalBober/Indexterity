{
  "extends": "../../packages/config/tsconfig.react.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"]
    },
    // node is declared rather than inherited by accident (the mistake
    // @repo/errors calls out): this app renders on the server, so src/lib/env.ts
    // and api-origin.ts read process.env, and the e2e suite reads Buffer. It
    // type-checked before only because a dependency's .d.ts happened to drag the
    // node types in behind it.
    "types": ["vite/client", "@testing-library/jest-dom", "node"]
  },
  // playwright.config.ts and e2e/ are here for the same reason as the rest: they
  // are TypeScript that ships in the repo, and nothing checked them. `*.config.ts`
  // is a glob so the next one is covered without a second edit.
  "include": ["src", "*.config.ts", "*.setup.ts", "e2e"]
}
