# Postgres — control-plane state (NOT the managed MongoDB clusters)
DATABASE_URL=postgres://mongo_optimizer:mongo_optimizer@localhost:5432/mongo_optimizer

# Secret sealing master key (32 bytes, base64). Generate: openssl rand -base64 32
MASTER_KEY=

# better-auth. BETTER_AUTH_URL is the DASHBOARD's public origin, not the api's
# port: the api serves better-auth under /api/auth on that same origin (an
# ingress rule in Kubernetes, nginx in compose, the vite dev server locally), and
# better-auth appends /api/auth itself. It is also what the links in reset and
# verification emails are built from.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Ports. 3000 is the origin a browser uses for everything, including /api; 3001
# is the api itself, reachable server-to-server and by curl.
API_PORT=3001
WEB_PORT=3000

# Outbound mail (invites + alerts). Leave empty to disable sending.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Run the job runner inside the api process instead of a separate worker
# container. Off for hosted (a deploy would abort in-flight index builds, and
# the alert cooldown assumes one worker); on for small self-hosted installs.
RUN_WORKER=false

# Prometheus metrics on a second port (no auth — do not expose it publicly).
# Off by default here so two workloads started side by side do not fight over the
# port; the Helm chart turns it on. All three serve /metrics and report different
# parts: HTTP + control-plane state on the api, job and pipeline counters on the
# worker, render time + SSR reads of the api on the dashboard server.
METRICS_ENABLED=false
METRICS_PORT=9464

# Per-IP request budgets (per minute). Defaults are 300 overall and 20 on the
# auth endpoints; raise them for a shared egress IP or a test suite.
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20
