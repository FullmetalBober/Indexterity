# Postgres — control-plane state (NOT the managed MongoDB clusters)
DATABASE_URL=postgres://mongo_optimizer:mongo_optimizer@localhost:5432/mongo_optimizer

# Secret sealing master key (32 bytes, base64). Generate: openssl rand -base64 32
MASTER_KEY=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Ports
API_PORT=3001
WEB_PORT=3000

# Outbound mail (invites + alerts). Leave empty to disable sending.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
