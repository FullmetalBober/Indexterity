# Postgres — control-plane state (NOT the managed MongoDB clusters)
DATABASE_URL=postgres://mongo_optimizer:mongo_optimizer@localhost:5432/mongo_optimizer

# Secret sealing master key (32 bytes, base64). Generate: openssl rand -base64 32
MASTER_KEY=

# better-auth. BETTER_AUTH_URL is the DASHBOARD's public origin, not the api's
# port: the api serves better-auth under /api/auth on that same origin (an
# ingress rule in Kubernetes, nginx in compose, the vite dev server locally), and
# better-auth appends /api/auth itself. It is also what the links in reset and
# verification emails are built from.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Ports. 3000 is the origin a browser uses for everything, including /api; 3001
# is the api itself, reachable server-to-server and by curl. The dashboard's own
# port is PORT, which only the built image reads — `npm run dev` takes it from
# apps/web/vite.config.ts.
API_PORT=3001

# Outbound mail (invites, alerts, password resets, and the emailed two-factor
# sign-in code). Leave empty to disable sending — the two-factor "email me a
# code" button then refuses with a reason instead of silently sending nothing,
# and the authenticator app and backup codes still work.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Run the job runner inside the api process instead of a separate worker
# container. Off for hosted (a deploy would abort in-flight index builds, and
# the alert cooldown assumes one worker); on for small self-hosted installs.
RUN_WORKER=false

# Prometheus metrics on a second port (no auth — do not expose it publicly).
# Off by default here so two workloads started side by side do not fight over the
# port; the Helm chart turns it on. All three serve /metrics and report different
# parts: HTTP + control-plane state on the api, job and pipeline counters on the
# worker, render time + SSR reads of the api on the dashboard server.
METRICS_ENABLED=false
METRICS_PORT=9464

# Error reporting to Sentry, from all three workloads — the half the metrics
# above cannot answer: they say how often something failed, this says what.
# Empty means off, which is the default everywhere including the chart.
#
# Every process reads a plain SENTRY_DSN; these two are what compose maps onto
# each container, because there are two projects. The api and the worker share
# one — they are one image and one body of code, so a fault in the job or
# analysis layer would otherwise file twice — and the dashboard server has its
# own. A `service` tag says which workload answered.
#
# POINT THESE AT YOUR OWN PROJECTS. Left empty here on purpose: an install that
# defaulted to somebody else's Sentry would be a data leak with a nice UI.
# Connection strings and secrets are stripped from every event before it leaves
# the process (packages/errors), but the account it reaches is still yours to
# choose.
SENTRY_DSN_API=
SENTRY_DSN_WEB=
# Keeps staging, production and a local run out of each other's issue stream.
# Defaults to NODE_ENV, which calls the first two both "production".
SENTRY_ENVIRONMENT=

# Per-IP request budgets (per minute). Defaults are 300 overall and 20 on the
# auth endpoints; raise them for a shared egress IP or a test suite.
#
# Read RATE_LIMIT_MAX as PER REPLICA. @fastify/rate-limit keeps its counters in
# each api process's memory, so two replicas allow twice this, and a rolling
# deploy hands every bucket back at zero.
#
# AUTH_RATE_LIMIT_MAX is read twice. Fastify applies it to /api/auth/* the same
# per-replica way, and better-auth applies it to the credential endpoints
# (sign-in, sign-up, change-password, change-email) counting in Postgres, so that
# half is the whole deployment's budget rather than each pod's. better-auth's own
# limiter is on for NODE_ENV=production only — the api image sets it, this dev
# stack does not — and it keeps its tighter default of 3 a minute on the endpoints
# that send mail (password reset, verification email).
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20

# Demand a second factor of owners before any owner-only mutation (#55). Off by
# default so dev and the test suites work without enrolling an authenticator;
# a hosted install should set it — these are the accounts that can flip a
# customer's cluster live. Accounts that sign in through GitHub are exempt
# (no password to pair a code with; GitHub enforces its own second factor).
# Enrolment itself is always available from the account page.
# REQUIRE_OWNER_2FA=true

# Operator knobs. Every one of these is optional, and every one is validated at
# boot: leave it out and the default applies, set it to something malformed and
# the process refuses to start rather than reading it as the default.
#
# LOG_LEVEL is pino's (fatal/error/warn/info/debug/trace/silent).
# DEFAULT_ORG_PLAN is what a newly created organization lands on — the chart says
# SELF_HOSTED, which is what the BUSL grant covers.
# RETENTION_DAYS is your ceiling on history, in days. Storage is your bill, so it
# caps both what is KEPT and what any plan may SEE. Unset means no ceiling.
# STORAGE_USD_PER_GB_MONTH prices the $/month figure on the ROI panel.
# WORKER_CONCURRENCY is how many jobs the runner takes at once.
# ALLOW_UNTESTED_MONGO_VERSION lets a cluster on a newer major series connect.
# The floor is not overridable; this is the ceiling, and it is refused by default
# because the engine builds and drops indexes on a live database.
# LOG_LEVEL=info
# DEFAULT_ORG_PLAN=SELF_HOSTED
# RETENTION_DAYS=90
# STORAGE_USD_PER_GB_MONTH=0.25
# WORKER_CONCURRENCY=2
# ALLOW_UNTESTED_MONGO_VERSION=true

# Whether a trusted proxy sits in front, and which one. Every budget above is
# per client address, so this is what decides whether there ARE per-client
# budgets: behind a proxy the connection comes from the proxy, and an untrusted
# forwarded header is ignored — leaving one bucket that every caller shares.
#
# Off by default on purpose: trusting the header while directly exposed is worse
# than not resolving the address, because a client can then forge a fresh one per
# request and never reach a limit.
#
# Prefer a CIDR list to `true`. Fastify accepts "true", a hop count ("1") or a
# list; better-auth accepts only the list, and without one it believes
# X-Forwarded-For only when it holds a single address — which it does not behind
# an ingress, since the ingress adds itself. With "true", the auth limits fall
# back to one shared bucket for the whole deployment.
# TRUST_PROXY=10.0.0.0/8,192.168.0.0/16
