{
  "name": "indexterity",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck //#typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.json",
    "test": "turbo run test",
    "audit:gate": "node scripts/audit-gate.ts",
    "lint": "biome check . && node scripts/lint-tailwind.ts && node scripts/lint-migrations.ts && node scripts/lint-source-bytes.ts && npm run lint -w @repo/tunnel",
    "lint:fix": "biome check --write . && node scripts/lint-tailwind.ts && node scripts/lint-migrations.ts && node scripts/lint-source-bytes.ts && npm run lint -w @repo/tunnel",
    "lint:tailwind": "node scripts/lint-tailwind.ts",
    "lint:migrations": "node scripts/lint-migrations.ts",
    "lint:source-bytes": "node scripts/lint-source-bytes.ts",
    "format": "biome format --write .",
    "db:generate": "npm run db:generate -w @repo/api",
    "db:migrate": "npm run db:migrate -w @repo/api",
    "test:e2e": "turbo run build && npm run test:e2e -w @repo/web",
    "up": "bash scripts/compose.sh up",
    "down": "bash scripts/compose.sh down",
    "compose": "bash scripts/compose.sh",
    "version:set": "node scripts/set-version.ts set",
    "version:check": "node scripts/set-version.ts check",
    "skills:install": "npx skills experimental_install",
    "skills:update": "npx skills update -p"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@swc/core": true,
    "@sentry/cli": true
  },
  "license": "BUSL-1.1"
}
