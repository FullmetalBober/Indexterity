{
  "name": "indexterity",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "audit:gate": "node scripts/audit-gate.mjs",
    "lint": "biome check . && node scripts/lint-tailwind.mjs",
    "lint:fix": "biome check --write . && node scripts/lint-tailwind.mjs",
    "lint:tailwind": "node scripts/lint-tailwind.mjs",
    "format": "biome format --write .",
    "db:generate": "npm run db:generate -w @repo/api",
    "db:migrate": "npm run db:migrate -w @repo/api",
    "test:e2e": "turbo run build && npm run test:e2e -w @repo/web",
    "up": "bash scripts/compose.sh up",
    "down": "bash scripts/compose.sh down",
    "compose": "bash scripts/compose.sh",
    "version:set": "node scripts/set-version.mjs set",
    "version:check": "node scripts/set-version.mjs check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@swc/core": true,
    "@sentry/cli": true
  },
  "license": "BUSL-1.1"
}
